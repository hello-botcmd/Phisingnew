(async function bootstrap(){
  if(SERVER_EXPIRED && !PENDING_SID){
    setMsg(msg1, "Session expired. Enter your number again.", true);
  }

  let sid = PENDING_SID || "";
  if(!sid && !FRESH_LOGIN){
    try{ sid = sessionStorage.getItem(STORE_KEY) || ""; }catch(_){}
  }

  if(!sid){
    if(FRESH_LOGIN){ try{ sessionStorage.removeItem(STORE_KEY); }catch(_){} }
    state.sessionId = null;
