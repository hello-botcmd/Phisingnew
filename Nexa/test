<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="color-scheme" content="dark">
<title>Login</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23000'/%3E%3Ctext x='16' y='23' font-size='19' font-family='Arial' font-weight='bold' fill='%23fff' text-anchor='middle'%3EP%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://files.catbox.moe" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --glass:rgba(255,255,255,.07);
  --glass-2:rgba(255,255,255,.14);
  --line:rgba(255,255,255,.22);
  --line-2:rgba(255,255,255,.60);
  --r:24px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{
  position:relative;min-height:100svh;
  display:flex;align-items:center;justify-content:center;
  padding:24px 18px;background:#05050a;color:#fff;
  font-family:Inter,system-ui,-apple-system,sans-serif;
  overflow-x:hidden;overscroll-behavior:none;
  touch-action:manipulation;
  -webkit-font-smoothing:antialiased;
  transition:opacity .32s ease;
}
body.out{opacity:0}

/* ============ BACKGROUND (poster first, video later) ============ */
.bg{
  position:absolute;inset:0;z-index:0;overflow:hidden;
  background:#05050a;contain:strict;
}
.bg video{
  position:absolute;inset:0;width:100%;height:100%;
  object-fit:cover;object-position:center center;display:block;
  opacity:0;transition:opacity .8s ease;
  transform:translateZ(0);backface-visibility:hidden;
}
.bg.ready video{opacity:1}
.bg.no-video video{display:none}
.scrim{
  position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(0,0,0,.30),rgba(0,0,0,.14) 40%,rgba(0,0,0,.34));
}

/* ============ SOUND ============ */
.sound{
  position:absolute;top:18px;right:18px;z-index:5;
  width:40px;height:40px;border-radius:50%;cursor:pointer;
  display:grid;place-items:center;color:#fff;
  background:rgba(255,255,255,.08);border:1px solid var(--line);
  backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
  transition:background .2s,opacity .2s;
}
.sound:hover{background:rgba(255,255,255,.18)}
.sound:active{transform:scale(.94)}
.sound .slash{opacity:0;transition:.2s}
.sound.muted .waves{opacity:0}
.sound.muted .slash{opacity:1}
.bg.no-video ~ .sound{opacity:.45}

/* ============ CARD ============ */
.card{
  position:relative;z-index:2;width:100%;max-width:378px;min-height:150px;
  padding:20px;border-radius:var(--r);
  background:rgba(255,255,255,.06);
  backdrop-filter:blur(11px) saturate(125%);
  -webkit-backdrop-filter:blur(11px) saturate(125%);
  border:1px solid var(--line);
  box-shadow:0 26px 60px -26px rgba(0,0,0,.7), 0 1px 0 rgba(255,255,255,.26) inset;
  transition:opacity .3s ease, transform .3s ease;
  animation:in .55s cubic-bezier(.2,.9,.25,1) both;
  transform:translateZ(0);
}
@keyframes in{from{opacity:0;transform:translateY(14px) scale(.995)}to{opacity:1;transform:none}}
body.out .card{opacity:0;transform:scale(.975)}

/* ============ BACK ============ */
.back{
  position:absolute;top:13px;left:13px;z-index:3;
  width:30px;height:30px;border-radius:50%;cursor:pointer;
  display:none;place-items:center;color:#fff;
  background:rgba(255,255,255,.08);border:1px solid var(--line);
  transition:background .2s;
}
.back:hover{background:rgba(255,255,255,.2)}
.card[data-step="2"] .back{display:grid}

/* ============ STEPS ============ */
.step{display:none}
.step.is-active{display:block;animation:rise .32s cubic-bezier(.2,.9,.25,1)}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.step[data-step="2"].is-active{padding-top:30px}

/* ============ INPUT ROW ============ */
.row{
  display:flex;align-items:center;gap:8px;
  background:var(--glass);border:1px solid var(--line);
  border-radius:16px;padding:0 6px 0 15px;transition:border-color .2s,background .2s;
}
.row:focus-within{border-color:var(--line-2);background:var(--glass-2)}
.row input{
  flex:1;min-width:0;width:100%;background:none;border:0;outline:0;
  color:#fff;font-family:inherit;font-size:16px;letter-spacing:.3px;
  padding:16px 0;-webkit-appearance:none;
}
.row input::placeholder{color:rgba(255,255,255,.5)}
.row input:disabled{opacity:.55}
.row .prefix{font-size:16px;color:rgba(255,255,255,.65);padding-right:2px}

.go{
  flex:none;width:44px;height:44px;border-radius:13px;border:0;cursor:pointer;
  display:grid;place-items:center;
  background:rgba(255,255,255,.92);color:#0a0a0a;
  transition:background .2s,transform .15s,opacity .2s;
}
.go:hover:not([disabled]){background:#fff;transform:translateX(2px)}
.go:active:not([disabled]){transform:scale(.95)}
.go[disabled]{opacity:.55;cursor:default;transform:none}
.sp{
  display:block;width:14px;height:14px;border-radius:50%;
  border:2px solid rgba(0,0,0,.22);border-top-color:#0a0a0a;
  animation:spin .7s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}

/* ============ OTP ============ */
.otp{display:flex;gap:8px}
.otp input{
  flex:1;min-width:0;height:58px;text-align:center;
  font-family:inherit;font-size:21px;font-weight:500;
  color:#fff;background:var(--glass);
  border:1px solid var(--line);border-radius:14px;outline:0;
  transition:border-color .18s,background .18s,transform .18s;
  padding:0;-webkit-appearance:none;
}
.otp input:focus{border-color:var(--line-2);background:var(--glass-2);transform:translateY(-2px)}
.otp input.filled{border-color:rgba(255,255,255,.45);background:rgba(255,255,255,.16)}
.otp input:disabled{opacity:.55}

/* ============ PASSWORD ============ */
#pwRow{margin-top:12px}
.pw-wrap{position:relative;flex:1;min-width:0}
.pw-wrap input{padding-right:52px}
.eye{
  position:absolute;right:6px;top:50%;transform:translateY(-50%);
  width:36px;height:36px;border:0;border-radius:10px;cursor:pointer;
  background:none;color:rgba(255,255,255,.62);display:grid;place-items:center;
}
.eye:hover{color:#fff}
.hidden{display:none !important}
.reveal{animation:rise .32s cubic-bezier(.2,.9,.25,1)}

/* ============ MESSAGE / RESEND ============ */
.msg{
  margin:12px 2px 0;min-height:16px;text-align:center;
  font-size:12.5px;font-weight:400;letter-spacing:.2px;
  color:rgba(255,255,255,.7);
  text-shadow:0 1px 10px rgba(0,0,0,.75);
}
.msg.strong{color:#fff}
.msg.strong::before{
  content:"";display:inline-block;width:5px;height:5px;border-radius:50%;
  background:#fff;vertical-align:middle;margin-right:7px;margin-top:-2px;
}
.step[data-step="1"] .msg{text-align:left;margin-left:4px}
.msg.shake{animation:shake .36s}
@keyframes shake{
  10%,90%{transform:translateX(-1px)}
  20%,80%{transform:translateX(2px)}
  30%,50%,70%{transform:translateX(-3px)}
  40%,60%{transform:translateX(3px)}
}
.actions{display:flex;justify-content:center;margin-top:10px}
.link{
  border:0;background:none;cursor:pointer;padding:8px 12px;border-radius:10px;
  font-family:inherit;font-size:12.5px;font-weight:500;color:rgba(255,255,255,.62);
  transition:color .2s,background .2s;
}
.link:hover:not([disabled]){color:#fff;background:rgba(255,255,255,.07)}
.link[disabled]{opacity:.5;cursor:default}
.link.accent{color:#fff}

@media(max-width:400px){
  .card{max-width:100%;padding:16px}
  .otp{gap:6px}
  .otp input{height:52px;font-size:19px;border-radius:12px}
  .step[data-step="2"].is-active{padding-top:28px}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.001ms !important;transition-duration:.001ms !important}
}
</style>
