def _connect():
    global mongo_client, db, db_connected, _last_ping

    with _db_lock:
        old_client = mongo_client
        mongo_client = None
        db = None
        db_connected = False
        _unbind()

        if old_client is not None:
            try:
                old_client.close()
            except Exception:
                pass

        if not MONGODB_URI:
            error("MONGODB_URI is not configured", source="db")
            _last_ping = time.time()
            return False

        client = None
        try:
            client = MongoClient(
                MONGODB_URI,
                serverSelectionTimeoutMS=5000,
                connectTimeoutMS=5000,
                socketTimeoutMS=15000,
                retryWrites=True,
                maxPoolSize=50,
            )
            database = client[DB_NAME]
            client.admin.command("ping")

            mongo_client = client
            db = database
            _bind(database)
            db_connected = True
            _last_ping = time.time()

            info("MongoDB connected", source="db")
            _ensure_indexes()
            return True

        except Exception as exc:
            error(f"MongoDB connection failed: {type(exc).__name__}: {exc}", source="db")
            if client is not None:
                try:
                    client.close()
                except Exception:
                    pass
            mongo_client = None
            db = None
            db_connected = False
            _unbind()
            _last_ping = time.time()
            return False


def ensure_db():
    global _last_ping, db_connected
    with _db_lock:
        now = time.time()
        if mongo_client is None or not db_connected:
            return _connect()
        if now - _last_ping < _PING_INTERVAL:
            return True
        try:
            mongo_client.admin.command("ping")
            db_connected = True
            _last_ping = time.time()
            return True
        except Exception as exc:
            warn(f"MongoDB ping failed: {exc}", source="db")
            return _connect()


